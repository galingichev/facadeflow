# FacadeFlow Backend API
FACADEFLOW_API_URL=http://localhost:3000/api
FACADEFLOW_API_KEY=your_api_key_here
FACADEFLOW_WEBHOOK_SECRET=shared_secret_for_webhook_verification

# Supabase (if using)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Telegram (for daily brief and notifications)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=6965983037

# GitHub integration (optional)
GITHUB_TOKEN=ghp_your_github_token

# OpenAI (for Whisper transcription if not using OpenClaw's skill directly)
OPENAI_API_KEY=sk-openai-key

# App environment
NODE_ENV=development

# OpenClaw specific (for AgentSkill communication)
# These are handled by OpenClaw itself, but can be overridden:
# OPENCLAW_SESSION_KEY=...
# OPENCLAW_GATEWAY_URL=...
