SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
PORT=3000

# Required for MVP project creation.
# Must be an existing Supabase users.id UUID, not a random UUID.
FACADEFLOW_MVP_OWNER_ID=<existing users.id UUID>

# Optional deployment guardrails.
# Leave unset for local/private demo mode.
# Set comma-separated public origins for deployed demos, for example:
# FACADEFLOW_CORS_ORIGINS=https://demo.example.com,https://app.example.com
FACADEFLOW_CORS_ORIGINS=

# Set to true only when clients send Supabase JWTs as Authorization: Bearer <token>.
# Requires SUPABASE_URL plus SUPABASE_ANON_KEY or SUPABASE_SERVICE_ROLE_KEY.
FACADEFLOW_REQUIRE_AUTH=
